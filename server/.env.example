# Orbis server 配置（全部可选）
# 用法：复制成 .env，然后 node --env-file=.env src/index.js

# 监听
ORBIS_PORT=8787

# 数据/工作目录（agent 只能在这个目录里干活）
# ORBIS_HOME=/path/to/Orbis-data
# ORBIS_WORKSPACE=/path/to/Orbis-workspace

# 模型（留空用 pi 的默认模型）
# ORBIS_MODEL=
ORBIS_THINKING=medium

# 固定 token（设了就跳过配对码，服务器部署用）。
# 设了就是服务器模式：本机请求也要带 token（反向代理转发过来的请求看起来也是本机）。
# ORBIS_TOKEN=

# 反向代理保留原始 Host 时，填你的域名（逗号分隔，不带端口）
# ORBIS_ALLOWED_HOSTS=pi.example.com

# 本机请求免不免 token（默认：没设 ORBIS_TOKEN 时免，设了时不免）
# ORBIS_TRUST_LOCAL=0

# 联网搜索（不配也能用）
# ORBIS_SEARCH_URL=
# ORBIS_SEARCH_KEY=

# 上下文预算
# ORBIS_RESERVE_TOKENS=
# ORBIS_KEEP_RECENT_TOKENS=

# 单轮超时（毫秒，0=不限）
ORBIS_RUN_TIMEOUT_MS=600000

# ---- 长任务：时间片、续跑守卫、默认自主 ----
# 单段到时后的收尾宽限（毫秒）。到点先叫它收尾并报进度，再给这段宽限；
# 宽限里工具还在出结果就再宽限一次。0 = 旧行为（到点硬断）。
# ORBIS_TURN_GRACE_MS=180000

# 单段硬上限（毫秒）。0 = 自动（单段 × 3）。
# 超过这个值才算真的该断，断了记「让出」并按续段接着做，不记失败。
# ORBIS_TURN_HARD_MAX_MS=0

# 看门狗阈值：有工具正在执行时放宽到这个值（毫秒），默认 15 分钟。
# 以前一律按"多久没动静"判死，长命令（装依赖、跑构建）会被误杀。
# ORBIS_TOOL_STALL_MS=900000

# 续跑守卫：回合收尾判成"半路停下来问"时，同一会话追加「继续执行」。
# 设 0 关掉。
# ORBIS_CONTINUE_GUARD=1

# 每轮最多催几次（催了仍只回文字 = 真需要用户，不再催）。
# ORBIS_CONTINUE_GUARD_MAX=2

# 非受管会话（私聊/群聊）连续自动续段的上限，0 = 关。
# ORBIS_AUTO_CONTINUE_MAX=12

# 新任务默认自主推进（做完为止，不停下来问）。
# 设 0 退回「只有用户明确授权才自主」。
# ORBIS_TASK_AUTONOMY=1

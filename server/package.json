{
  "name": "orbis-agent",
  "version": "2.0.0-rc.3",
  "private": false,
  "type": "module",
  "description": "Orbis: Multi-Agent Foundation & Jarvis Runtime",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/sdk/index.d.ts",
      "default": "./src/sdk/index.js"
    },
    "./sdk": {
      "types": "./types/sdk/index.d.ts",
      "default": "./src/sdk/index.js"
    },
    "./client": {
      "types": "./types/sdk/client.d.ts",
      "default": "./src/sdk/client.js"
    },
    "./capabilities": {
      "types": "./types/capabilities.d.ts",
      "default": "./src/capabilities.js"
    },
    "./server": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "orbis": "./src/index.js",
    "orbis-server": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node tests/all.mjs",
    "test:integration": "node tests/smoke.mjs",
    "relay": "node src/relay-server.js",
    "relay-agent": "node src/relay-agent.js",
    "test:relay": "node tests/relay.mjs && node tests/relay-limits.mjs",
    "build:desktop-mac": "bash ../scripts/build-desktop-mac.sh",
    "types": "tsc -p tsconfig.types.json",
    "check:types": "tsc -p tsconfig.examples.json",
    "examples": "node examples/sdk/01-minimal.mjs",
    "prepack": "node scripts/prepare-pack.mjs && npm run types",
    "check:pack": "node scripts/check-pack.mjs",
    "check:pack-install": "node scripts/check-pack-install.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "cheerio": "^1.2.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "typebox": "1.3.27",
    "undici": "^7.16.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "types": "./types/sdk/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loving-cat/orbis.git"
  },
  "files": [
    "src/**/*.js",
    "types/**/*.d.ts",
    "examples/sdk/**",
    "docs/SDK.md",
    "README.md",
    "LICENSE"
  ]
}

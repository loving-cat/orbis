{
  "_comment": "旧品牌残留基线（scripts/check-legacy.mjs）。entries = 待清债项，只许变小：新增文件或计数上涨都会让 CI 变红；permanent = 永远不删的身份常量（C6 / 应用 ID / Dart 包名），命中不计入债务。清理进度见 docs/ROADMAP-2.0.md §1.1 / §3。",
  "permanent": [
    {
      "pattern": "pibot.discover",
      "reason": "C6 mDNS 探测类型：1.x 客户端靠它发现 2.x 服务端，永久双播"
    },
    {
      "pattern": "pibot.host",
      "reason": "C6 mDNS 公告类型：同上，永久双播"
    },
    {
      "pattern": "pi-bot.local",
      "reason": "C6 TLS 自签证书名：1.x 客户端按它校验，2.x 保留"
    },
    {
      "pattern": "com.pibot.pi_bot",
      "reason": "Android applicationId：改了老用户装不上更新，只能卸载重装"
    },
    {
      "pattern": "io.pibot.piBot",
      "reason": "macOS bundle id：改了等于换新应用（权限/钥匙串/偏好全重来）"
    },
    {
      "pattern": "package:pi_bot/",
      "reason": "Dart 包名（pubspec name: pi_bot）：改名要动全仓 import，无用户可见收益"
    },
    {
      "pattern": "name: pi_bot",
      "reason": "Dart 包名声明（pubspec.yaml）"
    },
    {
      "pattern": "pi-bot.config.json",
      "reason": "旧配置文件名的常量（C5 读旧写新：迁移命令要按这个名字找文件），2.1 之后才可能彻底消失"
    },
    {
      "pattern": "CN=pi-bot",
      "reason": "旧证书 CN 的回归断言（1.x 客户端按它认证书；SAN 里另有 orbis.local）"
    },
    {
      "pattern": "LEGACY_SLUG = 'pi-bot'",
      "reason": "旧 slug 常量的**定义**（兼容 1.x 的头/目录/包名都要它，2.1 前不删）"
    },
    {
      "pattern": "LEGACY_HOME_DIR_NAME = 'pi-bot'",
      "reason": "旧数据目录名的**定义**（`orbis migrate` 与服务端回退判定都靠它）"
    },
    {
      "pattern": "stateDirNameLegacy = 'pi-bot'",
      "reason": "App 侧旧状态目录名常量（日志/pid 文件位置，挪了老用户会找不到自己的日志）"
    },
    {
      "pattern": "commonName = 'pi-bot'",
      "reason": "证书签发函数/默认参数的旧 CN（1.x 按它认证书；SAN 里另有 orbis.local）"
    },
    {
      "pattern": "commonName: 'pi-bot'",
      "reason": "证书测试里显式传旧 CN（回归 `CN=pi-bot` 不被改动）"
    },
    {
      "pattern": "OID.organization, 'pi-bot'",
      "reason": "证书 subject 的 O 字段（改它等于换一张证书，固定指纹的客户端全部断连）"
    },
    {
      "pattern": "path.join(base, 'pi-bot')",
      "reason": "弃用/回退测试里构造旧目录（2.0 删回退时连测试一起改）"
    },
    {
      "pattern": "path.basename(picked), 'pi-bot'",
      "reason": "旧目录回退的断言（同上）"
    },
    {
      "pattern": "LEGACY_SLUG, 'pi-bot'",
      "reason": "旧 slug 常量值的断言"
    },
    {
      "pattern": "LEGACY_HOME_DIR_NAME, 'pi-bot'",
      "reason": "旧目录名常量值的断言"
    },
    {
      "pattern": "stateDirNameLegacy, 'pi-bot'",
      "reason": "App 旧状态目录名常量值的断言"
    },
    {
      "pattern": "expect(name, 'pi-bot'",
      "reason": "Dart 测试里旧目录名的断言"
    },
    {
      "pattern": "endsWith('pi-bot')",
      "reason": "Dart 测试里旧目录名的匹配器"
    },
    {
      "pattern": "contains('pi-bot')",
      "reason": "Dart 测试里旧目录名的匹配器（检测是否尝试过旧目录）"
    }
  ],
